{
  "schemaVersion": 1,
  "id": "metallum",
  "version": "${version}",
  "name": "MetalUniversal",
  "description": "This is a PoC Metal backend for Minecraft on iOS and macOS.",
  "authors": [
    "kokodio",
    "EternityQwQ",
    "yitenchen123"
  ],
  "contact": {
    "homepage": "https://github.com/PigeonCoders/MetalUniversal-Iris",
    "sources": "https://github.com/PigeonCoders/MetalUniversal-Iris",
    "issues": "https://github.com/PigeonCoders/MetalUniversal-Iris/issues"
  },
  "license": "MIT",
  "accessWidener": "metallum.accesswidener",
  "icon": "assets/metallum/icon.png",
  "environment": "*",
  "entrypoints": {
    "preLaunch": [
      "com.metallum.Metallum"
    ],
    "main": [
      "com.metallum.Metallum"
    ],
    "sodium:config_api_user": [
      "com.metallum.compat.sodium.MetallumSodiumConfig"
    ]
  },
  "mixins": [
    "metallum.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.2-",
    "java": ">=25",
    "sodium": ">=0.9.1",
    "iris": "*"
  }
}
